# poster.mplstyle — A0 conference poster format.
# Very large fonts, thick lines, readable from ~2m distance.

pdf.fonttype: 42
ps.fonttype: 42
font.family: sans-serif
font.sans-serif: Arial, Helvetica, DejaVu Sans
font.size: 24
mathtext.fontset: dejavusans

axes.linewidth: 2.4
axes.labelsize: 28
axes.labelweight: bold
axes.titlesize: 32
axes.titleweight: bold
axes.spines.top: False
axes.spines.right: False
axes.grid: False
axes.axisbelow: True
axes.prop_cycle: cycler('color', ['E69F00', '56B4E9', '009E73', 'D55E00', '0072B2', 'CC79A7', 'F0E442', '000000'])

xtick.direction: in
xtick.labelsize: 22
xtick.major.size: 8.0
xtick.major.width: 2.0
xtick.minor.visible: False
xtick.top: False

ytick.direction: in
ytick.labelsize: 22
ytick.major.size: 8.0
ytick.major.width: 2.0
ytick.minor.visible: False
ytick.right: False

lines.linewidth: 4.0
lines.markersize: 12
patch.linewidth: 1.5
errorbar.capsize: 5

legend.fontsize: 22
legend.title_fontsize: 22
legend.frameon: False
legend.handlelength: 2.0
legend.labelspacing: 0.5

figure.figsize: 16, 12
figure.dpi: 100
figure.constrained_layout.use: True
savefig.dpi: 150
savefig.bbox: tight
